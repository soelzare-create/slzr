# DaranX backend configuration
# Copy this file to `.env` and adjust values.

# --- Database ---
# Development default is SQLite (no server needed):
DATABASE_URL=sqlite:///./daranx.db
# Production (per blueprint) uses PostgreSQL, e.g.:
# DATABASE_URL=postgresql+psycopg://daranx:secret@localhost:5432/daranx

# --- Security ---
# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- App ---
APP_NAME=DaranX
DEBUG=true

# --- Initial admin (used by seed script) ---
FIRST_ADMIN_NAME=مدیر سیستم
FIRST_ADMIN_PHONE=09120000000
FIRST_ADMIN_PASSWORD=admin1234
