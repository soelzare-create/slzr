# Copy to .env and adjust. Never commit .env.

# Security — set a long random value in production.
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=*

# Database. Leave unset for zero-setup SQLite (dev), or point at PostgreSQL:
# DATABASE_URL=postgresql+psycopg://daranx:secret@localhost:5432/daranx

# JWT access-token lifetime (minutes)
ACCESS_MINUTES=480

# React dev server origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Business rules (Phase 1)
MIN_MARGIN_MULTIPLIER=1.05
SOFT_RESERVATION_HOURS=48

# Initial admin (created by `python manage.py seed`)
FIRST_ADMIN_PHONE=09120000000
FIRST_ADMIN_PASSWORD=admin1234
FIRST_ADMIN_NAME=مدیر سیستم
