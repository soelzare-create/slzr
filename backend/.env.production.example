# Copy to .env (or set as real environment variables on your host / PaaS).
# NEVER commit the filled-in file.

# --- Security ---------------------------------------------------------------
# Generate a fresh value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-value
DEBUG=false

# Domains that serve this backend (comma-separated, no scheme).
ALLOWED_HOSTS=api.daranx.com

# Trusted origins for CSRF / admin over HTTPS (comma-separated, WITH scheme).
CSRF_TRUSTED_ORIGINS=https://api.daranx.com

# --- Database (PostgreSQL) --------------------------------------------------
# With docker-compose this points at the "db" service below.
DATABASE_URL=postgresql+psycopg://daranx:CHANGE_ME@db:5432/daranx

# --- HTTPS hardening --------------------------------------------------------
# Turn these on AFTER confirming TLS works end-to-end through your proxy.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true

# --- CORS (the React frontend origin[s]) ------------------------------------
CORS_ORIGINS=https://app.daranx.com

# --- App / JWT --------------------------------------------------------------
ACCESS_MINUTES=480

# --- Business rules (Phase 1) ----------------------------------------------
MIN_MARGIN_MULTIPLIER=1.05
SOFT_RESERVATION_HOURS=48

# --- First admin (created by the seed step on first boot) -------------------
# Change the password immediately after the first login.
FIRST_ADMIN_PHONE=09120000000
FIRST_ADMIN_PASSWORD=change-me-strong
FIRST_ADMIN_NAME=مدیر سیستم

# Set to false after the first successful boot so the seed step is skipped.
SEED_ON_START=true

# --- gunicorn ---------------------------------------------------------------
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=60
