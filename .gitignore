# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Test / coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Env / secrets
.env
*.db
*.sqlite3

# Collected static assets (produced by `collectstatic` / built into the image)
staticfiles/

# Node / frontend
node_modules/
dist/
.vite/

# Frontend build copied into the backend for the cPanel/Passenger deploy
# (see .github/workflows/deploy-app.yml) — generated, never committed.
backend/frontend_dist/

# Passenger startup-tasks marker (see backend/passenger_wsgi.py) — only
# ever exists on the deployed host, never in a checkout.
backend/.deployed

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
